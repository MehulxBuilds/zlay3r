{
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "PORT",
    "MCP_PORT",
    "MCP_API_BASE",
    "MCP_API_KEY",
    "HOST",
    "WEB_URL",
    "GOOGLE_CLIENT_ID",
    "MODEL_BASE_URL",
    "MODEL_API_KEY",
    "MODEL_NAME",
    "DOCKER_SOCKET",
    "LOG_LEVEL",
    "INSTANCE_ID",
    "SANDBOX_IMAGE",
    "SANDBOX_SECCOMP",
    "WORKER_CONCURRENCY",
    "ENCRYPTION_KEY",
    "R2_ACCOUNT_ID",
    "R2_BUCKET",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "NEXT_PUBLIC_API_BASE",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID"
  ],
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "20",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    }
  },
  "globalDependencies": ["env/.env.*"]
}
