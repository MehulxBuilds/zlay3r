NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres
REDIS_URL=redis://localhost:6379
PORT=3001
HOST=0.0.0.0
WEB_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
DOCKER_SOCKET=/var/run/docker.sock
LOG_LEVEL=info
SANDBOX_IMAGE=zlayer-sandbox:local
SANDBOX_RUNTIME=kata
SANDBOX_SECCOMP=
WORKER_CONCURRENCY=3
ENCRYPTION_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
INSTANCE_ID=local
MCP_PORT=3002
MCP_API_BASE=http://localhost:3001
MCP_API_KEY=
NEXT_PUBLIC_API_BASE=http://localhost:3001
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional Firecracker host service (Ubuntu/Linux only).
FIRECRACKER_SOCKET=/run/zlayer-firecracker/manager.sock
FIRECRACKER_BINARY=/usr/local/bin/firecracker
FIRECRACKER_JAILER=/usr/local/bin/jailer
FIRECRACKER_KERNEL=/opt/zlayer-firecracker/vmlinux
FIRECRACKER_ROOTFS=/opt/zlayer-firecracker/rootfs.ext4
FIRECRACKER_HELPER=/opt/zlayer-firecracker/helper.mjs
FIRECRACKER_STATE_DIR=/var/lib/zlayer-firecracker
# Set to the Ubuntu group ID allowed to use the manager socket.
FIRECRACKER_SOCKET_GID=0
FIRECRACKER_UID_BASE=40000
FIRECRACKER_MAX_VMS=32
