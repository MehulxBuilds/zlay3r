{
  "name": "console-me",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome lint apps packages scripts",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:studio": "turbo db:studio",
    "db:push": "turbo db:push",
    "db:initialize": "bun run --cwd packages/db db:initialize",
    "check-dependencies": "bun scripts/check-dependencies.ts",
    "test": "bun run --cwd packages/agent-runner build && bun test apps/http/src apps/remote-mcp/src apps/worker/src packages/agent-runtime/src",
    "sandbox:build": "docker build -f packages/sandbox/image/Dockerfile -t zlayer-sandbox:local .",
    "sandbox:smoke-agent": "tsx apps/worker/src/smoke-sandbox-agent.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/bun": "1.3.5",
    "prettier": "3.7.4",
    "tsx": "4.20.6",
    "turbo": "2.8.9",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "typescript": "5.9.3",
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "19.2.3",
    "ioredis": "5.9.3",
    "@grpc/proto-loader": "0.8.1",
    "protobufjs": "7.6.6",
    "@radix-ui/react-primitive": "2.1.4",
    "@radix-ui/react-slot": "1.2.4",
    "esbuild": "0.25.12",
    "dotenv": "17.3.1",
    "debug": "4.4.3",
    "gaxios": "7.1.4",
    "fast-json-stringify": "6.4.0",
    "fast-uri": "4.2.4",
    "process-warning": "5.1.1",
    "cookie": "1.1.1",
    "uuid": "10.0.0",
    "semver": "7.7.4",
    "picomatch": "4.0.3",
    "postcss": "8.5.6"
  }
}
